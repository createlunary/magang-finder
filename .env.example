# ---------------------------------------------------------------- panel lokal (.env.local)
# Kosong = mode demo (data tiruan, tanpa backend).
# "auto" = FastAPI di host yang sama dengan halaman, port 8000 (bisa dibuka dari HP di WiFi yang sama).
NEXT_PUBLIC_API_URL=
# Alamat situs showcase, tempat login Google untuk panel lokal. Contoh: https://magang-finder.vercel.app
NEXT_PUBLIC_SHOWCASE_URL=

# ---------------------------------------------------------------- situs showcase (env Vercel)
# NEXT_PUBLIC_MODE=showcase
# NEXT_PUBLIC_SNAPSHOT_URL=https://raw.githubusercontent.com/<akun>/<repo>/showcase-data/snapshot.json
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MF_JEMBATAN_SECRET=          # sama persis dengan di .env backend
# MF_EMAIL_IZIN=               # email Google yang boleh membuka panel, pisahkan dengan koma
